# Frontend env. Non-secret; values are inlined into the static build.

# API origin. Empty in production (frontend and API share one origin).
# For `npm run dev` the API runs separately on :8000 (see .env.development).
NEXT_PUBLIC_API_BASE_URL=

# Show the one-click synthetic reviewer accounts on the login page.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
