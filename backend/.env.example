# Copy to backend/.env for local development. Never commit real values.

# Postgres connection string (docker-compose defaults shown).
DATABASE_URL=postgresql://dealer:dealer@localhost:5432/dealership

# HMAC secret for signing access tokens (min 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-only-secret-change-me-0123456789

# Access token / session lifetime in minutes.
ACCESS_TOKEN_TTL_MINUTES=30

# PBKDF2 iterations used when hashing new passwords (seed). Verification uses the
# iteration count stored with each hash. Tests lower this for speed.
PASSWORD_HASH_ITERATIONS=600000

# Comma-separated browser origins allowed to call the API cross-origin.
# Needed for `npm run dev` (frontend on :3000, API on :8000). Leave empty in production,
# where the frontend and API share one origin.
CORS_ORIGINS=http://localhost:3000

# Reported by GET /api/health. CI/deploy sets this to the git SHA.
APP_VERSION=dev

# Optional: serve a built frontend (frontend/out) from the API on the same origin.
# Used by the E2E tests to mimic production. Leave empty otherwise.
STATIC_DIR=
